# Vorlage. Kopieren nach .env.local und ausfüllen:
#
#     cp .env.example .env.local
#
# .env.local ist ignoriert und darf nie ins Repo. Hier stehen nur Namen,
# niemals echte Schlüssel.
#
# Reihenfolge entspricht der Startliste: von oben nach unten ausfüllen,
# nach jedem Block einmal starten und schauen, ob es läuft.


# ── 1. Pflicht: ohne das startet nichts ────────────────────────────────

# Supabase (Projekt anlegen, dann Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Eigene Adresse. Lokal http://localhost:3000, später die echte Domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── 2. Pflicht: ohne das steht der Kern ────────────────────────────────

# Bildverarbeitung in Schritt 2 läuft vollständig über Gemini.
GEMINI_API_KEY=

# Fahrzeugschein und Ausstattung auslesen. Auch die Messskripte in
# scripts/ brauchen diesen Schlüssel.
ANTHROPIC_API_KEY=


# ── 3. Bezahlung ───────────────────────────────────────────────────────
#
# Reihenfolge: Secret Key eintragen, dann POST /api/stripe/setup aufrufen
# (geschützt durch STRIPE_SETUP_TOKEN, vorher setzen), danach die
# zurückgegebenen Price IDs hier eintragen. Webhook zuletzt.

STRIPE_SECRET_KEY=
STRIPE_SETUP_TOKEN=
STRIPE_WEBHOOK_SECRET=

STRIPE_BASIC_MONTHLY_PRICE_ID=
STRIPE_BASIC_YEARLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=


# ── 4. E-Mail ──────────────────────────────────────────────────────────
# Anfragen, Kündigungen, Rechnungen. Ohne das kommt nichts beim Händler an.

RESEND_API_KEY=
RESEND_FROM=
RESEND_OWNER_EMAIL=
SUPPORT_EMAIL=


# ── 5. Daten für die eigenen Rechnungen ────────────────────────────────

COMPANY_OWNER=
COMPANY_ADDRESS=
COMPANY_STEUERNUMMER=
COMPANY_TAX_ID=


# ── 6. Preise ──────────────────────────────────────────────────────────

PREIS_DAT_EUR=
PREIS_EXTRA_BILD_CENT=
NEXT_PUBLIC_PREIS_EXTRA_BILD_CENT=


# ── 7. Portale: erst wenn die Zugangsdaten da sind ─────────────────────
#
# Solange hier nichts steht, darf kein Tarif beworben werden, der die
# Übertragung an mobile.de oder AutoScout24 verspricht.

MOBILEDE_API_USERNAME=
MOBILEDE_API_PASSWORD=
MOBILEDE_SELLER_ID=
MOBILEDE_SANDBOX=true

AS24_API_USERNAME=
AS24_API_PASSWORD=
AS24_CUSTOMER_ID=
AS24_TESTMODUS=true

# Schlüssel, mit dem Händler ihre Portalzugänge hinterlegen.
PORTAL_SCHLUESSEL=


# ── 8. Optional ────────────────────────────────────────────────────────

# Eigener Freisteller statt Gemini. Nur nötig, wenn der genutzt wird.
NEXT_PUBLIC_FREISTELLER_URL=
BIREFNET_MODELL=
BIREFNET_KANTE=
BIREFNET_KERNE=
U2NET_URL=
U2NET_KERNE=
FAL_KEY=

# Schwellen und Zeitlimits der Bildprüfung. Leer lassen heißt Standard.
GEMINI_BILD_MODELL=
GEMINI_BILD_GROESSE=
GEMINI_ZEITLIMIT_MS=
GEMINI_AEHNLICH_MIN=
GEMINI_GEAENDERT_MIN=
GEMINI_VERFEINERN_MIN=
GEMINI_LEERER_RAUM_MAX=
STAPEL_MODELL=
STUDIO_WEG=
STUDIO_GEMINI_WEG=
STUDIO_SCHATTEN=

# Zugang zur Baustellen-Ansicht.
BAUZAUN_SCHLUESSEL=

# Erlaubte Herkunft für Anfragen von außen (CORS).
ERLAUBTE_HERKUNFT=

# Altlast: PhotoRoom wurde laut Startliste am 28.10.2026 ausgebaut. Wird
# der Schlüssel nirgends mehr gebraucht, gehört die Variable aus dem Code.
PHOTOROOM_API_KEY=
