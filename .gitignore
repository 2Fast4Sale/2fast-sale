# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Werkzeuge und Wegwerfdaten aus der Entwicklung
#
# .testkonto.json enthaelt ein Passwort im Klartext — es darf unter
# keinen Umstaenden ins Repository. Die .mjs-Dateien daneben legen
# Konten an, loeschen Datensaetze oder starten einen Browser; sie
# gehoeren zum Arbeiten an der Anwendung, nicht zur Anwendung.
.testkonto.json
.testsitzung*
.devserver.log
bild.mjs
testkonto.mjs
farben-messen.mjs
kuendigungen-aufraeumen.mjs

# Bildschirmaufnahmen aus dem Pruefen
.*.png
